{
  "name": "@frontmail/react",
  "version": "0.1.0",
  "description": "React bindings for Frontmail: FrontmailProvider, useSendEmail and <FrontmailForm> with Turnstile.",
  "private": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown --config-loader native",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@frontmail/sdk-core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "tsdown": "^0.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@testing-library/react": "^16.3.3",
    "jsdom": "^30.1.1"
  },
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frontmail-dev/frontmail-js.git",
    "directory": "packages/sdk-react"
  },
  "homepage": "https://docs.frontmail.dev/sdks/react/",
  "bugs": {
    "url": "https://github.com/frontmail-dev/frontmail-js/issues"
  }
}
