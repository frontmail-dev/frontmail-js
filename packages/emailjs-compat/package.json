{
  "name": "@frontmail/emailjs-compat",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./umd": "./dist/emailjs-compat.umd.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown --config-loader native",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --testTimeout=30000 --hookTimeout=60000"
  },
  "devDependencies": {
    "@frontmail/sdk-core": "workspace:*",
    "tsdown": "^0.23.0",
    "jsdom": "^30.1.1"
  },
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frontmail-dev/frontmail-js.git",
    "directory": "packages/emailjs-compat"
  },
  "homepage": "https://docs.frontmail.dev/sdks/emailjs-compat/",
  "bugs": {
    "url": "https://github.com/frontmail-dev/frontmail-js/issues"
  },
  "description": "Drop-in replacement for @emailjs/browser backed by Frontmail – migrate by changing the import.",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/emailjs-compat.umd.js",
  "jsdelivr": "./dist/emailjs-compat.umd.js",
  "keywords": [
    "emailjs",
    "email",
    "contact-form",
    "frontmail",
    "migration"
  ]
}
