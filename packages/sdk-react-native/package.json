{
  "name": "@frontmail/react-native",
  "version": "0.1.0",
  "description": "React Native bindings for Frontmail: FrontmailProvider, useSendEmail, AsyncStorage-backed limitRate and a Turnstile WebView.",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown --config-loader native",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --testTimeout=30000 --hookTimeout=60000"
  },
  "dependencies": {
    "@frontmail/sdk-core": "workspace:*"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": ">=1.19",
    "react": ">=18",
    "react-native": ">=0.72",
    "react-native-webview": ">=13"
  },
  "peerDependenciesMeta": {
    "@react-native-async-storage/async-storage": {
      "optional": true
    },
    "react-native-webview": {
      "optional": true
    }
  },
  "devDependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.1.0",
    "jsdom": "^30.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-webview": "13.16.1",
    "tsdown": "^0.23.0"
  },
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frontmail-dev/frontmail-js.git",
    "directory": "packages/sdk-react-native"
  },
  "homepage": "https://docs.frontmail.dev/sdks/react-native/",
  "bugs": {
    "url": "https://github.com/frontmail-dev/frontmail-js/issues"
  },
  "keywords": [
    "frontmail",
    "email",
    "react-native",
    "expo",
    "contact-form"
  ]
}
